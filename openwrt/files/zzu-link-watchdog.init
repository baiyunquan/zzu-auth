#!/bin/sh /etc/rc.common
# zzu-link-watchdog procd 启动脚本（链路状态联动与自愈看门狗）

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/zzu-link-watchdog"

start_service() {
	local enabled upstream downstream target portal interval threshold cooldown verbose

	config_load zzu-auth
	config_get_bool enabled watchdog enabled 0
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || return 1

	config_get upstream watchdog upstream ""
	config_get downstream watchdog downstream ""
	config_get target watchdog target ""
	config_get portal watchdog portal ""
	config_get interval watchdog interval 10
	config_get threshold watchdog threshold 3
	config_get cooldown watchdog cooldown 60
	config_get_bool verbose watchdog verbose 0

	set -- -i "$interval" -f "$threshold" -c "$cooldown"
	[ -n "$upstream" ]   && set -- "$@" -u "$upstream"
	[ -n "$downstream" ] && set -- "$@" -d "$downstream"
	[ -n "$target" ]     && set -- "$@" -t "$target"
	[ -n "$portal" ]     && set -- "$@" -P "$portal"
	[ "$verbose" -eq 1 ] && set -- "$@" -v

	procd_open_instance "zzu-link-watchdog"
	procd_set_param command "$PROG" "$@"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "zzu-auth"
}
