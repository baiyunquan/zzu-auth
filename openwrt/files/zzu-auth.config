# zzu-auth UCI 多接口多拨配置
# 支持为多个 WAN / macvlan 接口分别配置独立的后台守护探测与自动认证

# 实例 1：主物理 WAN 接口（例如选择中国联通）
config instance 'wan'
	option enabled '1'
	option interface 'wan'
	option isp 'unicom'             # 宽带运营商：campus (校园网), unicom (中国联通), cmcc (中国移动), telecom (中国电信)
	option interval '15'            # 检测间隔（秒）
	option timeout '10'             # 单次请求超时（秒）
	# option user '2024xxxxxx'      # 若已编译写死在程序中，留空即可
	# option password 'yourpassword'# 若已编译写死在程序中，留空即可
	# option suffix '@unicom'       # 亦可直接填写自定义后缀
	option encrypt '0'
	option verbose '0'
	# option check_url 'http://connect.rom.miui.com/generate_204'
	# option portal '172.16.2.9:801'

# 实例 2：多拨虚拟接口（macvlan0，例如选择校园网原生）
config instance 'wanb'
	option enabled '1'
	option interface 'macvlan0'
	option isp 'campus'             # 宽带运营商：campus (校园网), unicom (中国联通), cmcc (中国移动), telecom (中国电信)
	option interval '15'            # 检测间隔（秒）
	option timeout '10'             # 单次请求超时（秒）
	# option user '2024xxxxxx'      # 若已编译写死在程序中，留空即可
	# option password 'yourpassword'# 若已编译写死在程序中，留空即可
	# option suffix ''              # 留空或填写 campus 均表示无后缀
	option encrypt '0'
	option verbose '0'
	# option check_url 'http://connect.rom.miui.com/generate_204'
	# option portal '172.16.2.9:801'
