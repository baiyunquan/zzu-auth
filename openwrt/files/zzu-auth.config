# zzu-auth UCI 多接口多拨配置
# 支持为多个 WAN / macvlan 接口分别配置独立的后台守护探测与自动认证

# 实例 1：主物理 WAN 接口
config instance 'wan'
	option enabled '1'
	option interface 'wan'
	option interval '15'            # 检测间隔（秒）
	option timeout '10'             # 单次请求超时（秒）
	# option user '2024xxxxxx'      # 若已编译写死在程序中，留空即可
	# option password 'yourpassword'# 若已编译写死在程序中，留空即可
	# option suffix ''              # 运营商后缀，留空则使用编译时配置
	option encrypt '0'
	option verbose '0'
	# option check_url 'http://connect.rom.miui.com/generate_204'
	# option portal '172.16.2.9:801'

# 实例 2：多拨虚拟接口（macvlan0）
config instance 'wanb'
	option enabled '1'
	option interface 'macvlan0'
	option interval '15'            # 检测间隔（秒）
	option timeout '10'             # 单次请求超时（秒）
	# option user '2024xxxxxx'      # 若已编译写死在程序中，留空即可
	# option password 'yourpassword'# 若已编译写死在程序中，留空即可
	# option suffix ''              # 运营商后缀，留空则使用编译时配置
	option encrypt '0'
	option verbose '0'
	# option check_url 'http://connect.rom.miui.com/generate_204'
	# option portal '172.16.2.9:801'
